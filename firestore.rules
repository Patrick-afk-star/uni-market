rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "patrickvenansio123@gmail.com";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasOnlyKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read: if isAdmin() || isOwner(userId);
      allow update: if isAdmin()
        || (isOwner(userId)
          && hasOnlyKeys([
            "uid",
            "email",
            "name",
            "displayName",
            "phone",
            "university",
            "verified",
            "suspended",
            "sales",
            "isOnline",
            "role",
            "createdAt",
            "lastSeen",
            "activity"
          ]));
      allow delete: if isAdmin();
    }

    match /verificationRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == "pending";
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /deals/{dealId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dealInterests/{interestId} {
      allow create: if true;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.customerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /analyticsEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.type in [
          "registration",
          "login",
          "google_signin",
          "listing_posted",
          "listing_view",
          "seller_contact",
          "deal_created"
        ];
      allow update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read, write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
